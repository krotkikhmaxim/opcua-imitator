# Скопировать в deploy/.env и заполнить. В git не коммитить (.env в .gitignore).
IMITATOR_IMAGE=opcua-imitator:local

# Куда имитатор ходит за станцией (имя сервиса в сети asutp-edge)
STATION_URL=http://asutp-station:8080
STATION_PROJECT_ID=
STATION_TIMEOUT_S=5

# Домен, с которого открывается UI имитатора (для CORS)
CORS_ORIGINS=https://opcuaimitator.ru

# Частота сохранения состояния на диск, секунды
PERSIST_INTERVAL_S=5
